# Porta do servidor (socket.io + página de download)
PORT=3002
# IP público ou domínio do servidor, sem porta (usado como padrão no app e nos instaladores)
SERVER_URL=localhost

# ===== LiveKit (voz e transmissão de tela) =====
# Binário: baixe em https://github.com/livekit/livekit/releases e coloque em
#   server/bin/livekit-server.exe (Windows) ou server/bin/livekit-server (Linux)
# Portas que precisam estar liberadas no roteador/firewall:
#   TCP 3002 (este servidor), TCP 7880 (sinalização), TCP 7881 (fallback de mídia), UDP 7882 (mídia)
# Opcional: sem secret, o server.js gera um aleatório a cada início (mínimo 32 caracteres)
# LIVEKIT_API_KEY=concord
# LIVEKIT_API_SECRET=
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
# Amigos conectando pelo IP público (port forwarding): true para o LiveKit descobrir o IP externo via STUN
# Na rede local ou por VPN (Radmin/ZeroTier/Hamachi) deixe false
LIVEKIT_USE_EXTERNAL_IP=false
# Opcional: força o IP anunciado para a mídia (ex.: seu IP público ou o IP da VPN)
# LIVEKIT_NODE_IP=
# Opcional: URL que os apps usam para chegar no LiveKit. Por padrão é ws://<host do SERVER_URL>:7880.
# Se o SERVER_URL passa pelo proxy do Cloudflare (nuvem laranja), o Cloudflare NÃO repassa a porta 7880
# nem UDP: crie um registro DNS sem proxy (nuvem cinza) apontando para o seu IP, ex.:
#   LIVEKIT_URL=ws://rtc.meudominio.com:7880
# O livekit-server local continua sendo iniciado normalmente
# LIVEKIT_URL=
